#!/usr/bin/env bash
#
# claude-resume — Claude Code の過去セッションを fzf で選んで再開する
#
# 使い方:
#   claude-resume          # 全プロジェクトのセッションを新しい順に一覧
#   claude-resume -c       # カレントディレクトリのプロジェクトのみ
#   claude-resume -l       # fzf を起動せず一覧表示のみ
#   claude-resume <query>  # fzf の初期クエリを指定
#
# 依存: fzf, jq, claude
# セッションデータ: ~/.claude/projects/<プロジェクトパス>/<session-id>.jsonl

set -euo pipefail

PROJECTS_DIR="${CLAUDE_PROJECTS_DIR:-$HOME/.claude/projects}"

usage() {
  # 冒頭のコメントブロック（shebang の次行から最初の非コメント行まで）を表示
  awk 'NR > 1 { if (!/^#/) exit; sub(/^# ?/, ""); print }' "$0"
  exit 0
}

current_only=false
list_only=false
query=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help) usage ;;
    -c|--current) current_only=true ;;
    -l|--list) list_only=true ;;
    *) query="$1" ;;
  esac
  shift
done

command -v fzf >/dev/null || { echo "error: fzf が必要です" >&2; exit 1; }
command -v jq  >/dev/null || { echo "error: jq が必要です" >&2; exit 1; }

# カレントディレクトリのみの場合、プロジェクトディレクトリ名に変換
# (例: /Users/foo/bar → -Users-foo-bar)
target_dir="$PROJECTS_DIR"
if $current_only; then
  slug=$(pwd | tr '/.' '--')
  target_dir="$PROJECTS_DIR/$slug"
  [[ -d "$target_dir" ]] || { echo "error: このディレクトリのセッションが見つかりません: $target_dir" >&2; exit 1; }
fi

# 各セッションの一覧行を生成する
#   タブ区切り: session_id, cwd, 更新日時(表示用), 概要
# ファイルの mtime 降順（=最近使った順）で出力する
list_sessions() {
  find "$target_dir" -name '*.jsonl' -maxdepth 2 -type f -print0 |
    xargs -0 stat -f '%m %N' |
    sort -rn |
    cut -d' ' -f2- |
    while IFS= read -r file; do
      session_id=$(basename "$file" .jsonl)

      # jq 一発でメタ情報を取り出す:
      #   cwd / 概要（summary があればそれ、なければ最初のユーザー発言）
      # isMeta=true は hook などが自動注入したメッセージなので除外する。
      # スラッシュコマンド開始のセッションは <command-args> の中身を発言として扱う。
      meta=$(jq -rs '
        def user_text:
          if startswith("<command-name>")
          then ((try capture("<command-args>(?<a>.*?)</command-args>"; "s").a) // "")
          elif startswith("<") then ""
          else . end;
        [.[] | select(.type == "user" and .isSidechain != true and .isMeta != true
                      and (.message.content | type == "string"))
             | {cwd, text: (.message.content | user_text)}
             | select(.text != "")] as $users
        | ([.[] | select(.type == "summary") | .summary] | first) as $summary
        | ($users | first | .cwd) as $cwd
        | ($summary // ($users | first | .text)
           | gsub("\\s+"; " ") | .[0:80]) as $desc
        | if $cwd == null then empty else "\($cwd)\t\($desc)" end
      ' "$file" 2>/dev/null) || continue
      [[ -n "$meta" ]] || continue  # ユーザー発言のないセッション（sidechain 等）はスキップ

      mtime=$(stat -f '%Sm' -t '%Y-%m-%d %H:%M' "$file")
      printf '%s\t%s\t%s\n' "$session_id" "$mtime" "$meta"
    done
}

# fzf のプレビュー: セッション内のユーザー発言を時系列で表示
preview_session() {
  local file="$1"
  jq -rs '
    def user_text:
      if startswith("<command-name>")
      then ((try capture("<command-args>(?<a>.*?)</command-args>"; "s").a) // "")
      elif startswith("<") then ""
      else . end;
    .[] | select(.type == "user" and .isSidechain != true and .isMeta != true
                 and (.message.content | type == "string"))
    | (.message.content | user_text) as $text
    | select($text != "")
    | "[\(.timestamp | sub("T"; " ") | .[0:16])] \($text | .[0:500])\n"
  ' "$file" 2>/dev/null || echo "(プレビューを取得できませんでした)"
}

# fzf の preview からは環境変数付きで自分自身が呼び出される
if [[ -n "${CLAUDE_RESUME_PREVIEW:-}" ]]; then
  preview_session "$CLAUDE_RESUME_PREVIEW"
  exit 0
fi

lines=$(list_sessions)
[[ -n "$lines" ]] || { echo "セッションが見つかりません" >&2; exit 1; }

if $list_only; then
  printf '%s\n' "$lines" | awk -F'\t' '{ printf "%s  %s\n%18s@ %s\n", $2, $4, "", $3 }'
  exit 0
fi

# preview は cwd に依存しないよう絶対パスで自分自身を渡す
script_path=$(cd "$(dirname "$0")" && pwd)/$(basename "$0")

selected=$(printf '%s\n' "$lines" | fzf \
  --query="$query" \
  --delimiter='\t' \
  --with-nth='2,4,3' \
  --nth='2..' \
  --header='Claude セッションを選択（Enter で再開 / Esc でキャンセル）' \
  --preview="CLAUDE_RESUME_PREVIEW=\$(find '$PROJECTS_DIR' -maxdepth 2 -name {1}.jsonl | head -1) '$script_path'" \
  --preview-window='down,40%,wrap') || exit 0

session_id=$(cut -f1 <<<"$selected")
session_cwd=$(cut -f3 <<<"$selected")

# セッションは元のプロジェクトディレクトリに紐づくので、そこへ移動してから再開する
if [[ -d "$session_cwd" ]]; then
  cd "$session_cwd"
else
  echo "warning: 元のディレクトリが存在しません: $session_cwd（カレントのまま再開します）" >&2
fi

echo "resuming: $session_id ($session_cwd)"
exec claude --resume "$session_id"
